generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Utilisateurs, classes, élèves, disciplines ----------

enum Role {
  ADMIN
  KHOLLEUR
  PROFESSEUR_REFERENT
  ELEVE
}

model Utilisateur {
  id       String @id @default(cuid())
  email    String @unique
  password String // hash bcrypt
  nom      String
  prenom   String
  // Une même personne peut cumuler plusieurs rôles (ex. khôlleur ET
  // professeur référent) avec un seul compte de connexion.
  roles    Role[]

  competences              Competence[]
  disponibilites           Disponibilite[]
  referentsMatiere         ProfesseurReferent[]
  creneaux                 Creneau[]
  planificationJobs        PlanificationJob[]
  eleve                    Eleve?
  tokensReinitialisation   TokenReinitialisationMotDePasse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Mot de passe oublié : un seul token actif à la fois par utilisateur (voir
// /api/auth/mot-de-passe-oublie, qui purge les anciens avant d'en créer un
// nouveau). On stocke un hash SHA-256 du token, jamais le token en clair —
// seul le lien envoyé par email le contient — pour qu'une fuite de la base
// ne suffise pas à réinitialiser un mot de passe à la place de quelqu'un.
model TokenReinitialisationMotDePasse {
  id            String   @id @default(cuid())
  tokenHash     String   @unique
  utilisateurId String
  expiration    DateTime

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([utilisateurId])
}

// Entité à part (et non un simple champ texte sur Classe) : plusieurs
// classes partagent la même année scolaire, et la gérer séparément évite
// les doublons/fautes de frappe ("2025-2026" vs "2025/2026" etc.).
model AnneeScolaire {
  id      String @id @default(cuid())
  libelle String @unique

  classes Classe[]
}

model Classe {
  id              String @id @default(cuid())
  nom             String
  anneeScolaireId String

  anneeScolaire AnneeScolaire         @relation(fields: [anneeScolaireId], references: [id])
  eleves        Eleve[]
  sessions      SessionKholle[]
  disciplines   ClasseDiscipline[]
  referents     ProfesseurReferent[]
  parametres    ParametreDiscipline[]

  @@unique([nom, anneeScolaireId])
}

model Eleve {
  id            String  @id @default(cuid())
  nom           String
  prenom        String
  classeId      String
  utilisateurId String? @unique // compte de connexion, optionnel
  // Langues vivantes choisies parmi les disciplines marquées
  // Discipline.estLangueVivante ; LV2 peut rester vide, LV1 doit être
  // différente de LV2 (contrôlé côté API).
  lv1Id         String?
  lv2Id         String?

  classe      Classe       @relation(fields: [classeId], references: [id])
  utilisateur Utilisateur? @relation(fields: [utilisateurId], references: [id])
  lv1         Discipline?  @relation("EleveLV1", fields: [lv1Id], references: [id])
  lv2         Discipline?  @relation("EleveLV2", fields: [lv2Id], references: [id])

  passages Passage[]
}

model Discipline {
  id               String  @id @default(cuid())
  nom              String  @unique
  estLangueVivante Boolean @default(false)

  competences Competence[]
  sessions    SessionKholle[]
  referents   ProfesseurReferent[]
  classes     ClasseDiscipline[]
  parametres  ParametreDiscipline[]
  elevesLV1   Eleve[]               @relation("EleveLV1")
  elevesLV2   Eleve[]               @relation("EleveLV2")
}

// Déclare qu'une discipline est khôllée dans une classe, indépendamment de
// l'assignation d'un professeur référent (qui peut se faire plus tard).
model ClasseDiscipline {
  id           String @id @default(cuid())
  classeId     String
  disciplineId String

  classe     Classe     @relation(fields: [classeId], references: [id], onDelete: Cascade)
  discipline Discipline @relation(fields: [disciplineId], references: [id])

  @@unique([classeId, disciplineId])
}

// Durée de préparation et durée de khôlle, propres à chaque (classe,
// discipline) : par exemple 30 min de préparation / 20 min de khôlle pour
// une matière non langue, 20/20 pour une langue vivante — mais ces valeurs
// peuvent différer d'une classe à l'autre pour une même discipline (voir
// écran "Paramètres"). Une ligne manquante retombe sur une valeur par
// défaut calculée à l'affichage (30/20 ou 20/20 selon Discipline.estLangueVivante),
// jamais codée en dur côté solveur.
model ParametreDiscipline {
  id                      String @id @default(cuid())
  classeId                String
  disciplineId            String
  dureePreparationMinutes Int
  dureeKholleMinutes      Int

  classe     Classe     @relation(fields: [classeId], references: [id], onDelete: Cascade)
  discipline Discipline @relation(fields: [disciplineId], references: [id])

  @@unique([classeId, disciplineId])
}

model Competence {
  kholleurId   String
  disciplineId String
  kholleur     Utilisateur @relation(fields: [kholleurId], references: [id])
  discipline   Discipline  @relation(fields: [disciplineId], references: [id])

  @@id([kholleurId, disciplineId])
}

model ProfesseurReferent {
  id            String @id @default(cuid())
  utilisateurId String
  classeId      String
  disciplineId  String

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id])
  classe      Classe      @relation(fields: [classeId], references: [id])
  discipline  Discipline  @relation(fields: [disciplineId], references: [id])

  // Plusieurs référents peuvent être assignés à la même (classe, discipline) ;
  // seule l'assignation exacte (même personne) est empêchée en double.
  @@unique([classeId, disciplineId, utilisateurId])
}

// ---------- Disponibilités et ressources ----------

model Disponibilite {
  id          String      @id @default(cuid())
  kholleurId  String
  kholleur    Utilisateur @relation(fields: [kholleurId], references: [id])
  jourSemaine Int? // 1 (lundi) - 7 (dimanche), si récurrent
  date        DateTime? // si ponctuel, remplace/complète le récurrent
  heureDebut  String // "14:00"
  heureFin    String
}

model Salle {
  id  String @id @default(cuid())
  nom String @unique

  creneaux Creneau[]
}

// ---------- Planification ----------

enum StatutSession {
  PLANIFICATION
  PLANIFIEE
  EN_COURS
  CLOTUREE
}

model SessionKholle {
  id           String        @id @default(cuid())
  classeId     String
  disciplineId String
  semaine      Int
  dateDebut    DateTime
  dateFin      DateTime
  statut       StatutSession @default(PLANIFICATION)

  classe             Classe              @relation(fields: [classeId], references: [id])
  discipline         Discipline          @relation(fields: [disciplineId], references: [id])
  creneaux           Creneau[]
  validationGrilles  ValidationGrille[]
  validationReferent ValidationReferent?

  @@unique([classeId, disciplineId, semaine])
}

model Creneau {
  id                    String   @id @default(cuid())
  sessionKholleId       String
  kholleurId            String
  salleId               String
  date                  DateTime
  // Heure de début de la khôlle elle-même (l'élève est alors face au
  // khôlleur) ; heureDebutPreparation est l'heure à laquelle l'élève
  // commence sa préparation, calculée à partir de la durée de préparation
  // de la discipline pour cette classe (voir ParametreDiscipline).
  // Nullable : absente pour les créneaux créés avant l'introduction de ce
  // champ.
  heureDebutPreparation String?
  heureDebut            String
  heureFin              String

  sessionKholle SessionKholle @relation(fields: [sessionKholleId], references: [id], onDelete: Cascade)
  kholleur      Utilisateur   @relation(fields: [kholleurId], references: [id])
  salle         Salle         @relation(fields: [salleId], references: [id])
  passages      Passage[]
}

model Passage {
  id        String @id @default(cuid())
  creneauId String
  eleveId   String
  ordre     Int

  creneau Creneau @relation(fields: [creneauId], references: [id], onDelete: Cascade)
  eleve   Eleve   @relation(fields: [eleveId], references: [id])
  note    Note?

  @@unique([creneauId, eleveId])
}

// ---------- Notation et validation en cascade ----------

model Note {
  id           String    @id @default(cuid())
  passageId    String    @unique
  passage      Passage   @relation(fields: [passageId], references: [id], onDelete: Cascade)
  valeur       Decimal?
  appreciation String?
  dateSaisie   DateTime?
  // Pièce jointe optionnelle (PDF ou Word) associée à cette khôlle — ex.
  // copie annotée, grille de correction détaillée. Stockée directement en
  // base (pas de volume de fichiers séparé à gérer en production) ; voir
  // /api/passages/[passageId]/fichier.
  fichierNom   String?
  fichierType  String?
  fichierData  Bytes?
}

enum StatutValidation {
  EN_ATTENTE
  VALIDE
}

model ValidationGrille {
  id              String           @id @default(cuid())
  kholleurId      String
  sessionKholleId String
  statut          StatutValidation @default(EN_ATTENTE)
  dateValidation  DateTime?

  sessionKholle SessionKholle @relation(fields: [sessionKholleId], references: [id], onDelete: Cascade)

  @@unique([kholleurId, sessionKholleId])
}

model ValidationReferent {
  id                   String           @id @default(cuid())
  sessionKholleId      String           @unique
  professeurReferentId String
  statut               StatutValidation @default(EN_ATTENTE)
  dateValidation       DateTime?

  sessionKholle SessionKholle @relation(fields: [sessionKholleId], references: [id])
}

// ---------- Génération du planning (job asynchrone OR-Tools) ----------

enum JobStatut {
  EN_COURS
  SUCCES
  ECHEC
  INFAISABLE
}

model PlanificationJob {
  id          String      @id @default(cuid())
  classeId    String
  semaine     Int
  disciplines String[]
  // Quotas fixés par l'admin avant génération : pour chaque (jour, discipline,
  // kholleur), le nombre d'élèves à lui affecter. OR-Tools choisit ensuite
  // quels élèves précis remplissent ces quotas. Conservé pour traçabilité.
  // Forme : [{ jourSemaine, disciplineId, kholleurId, nombreEleves }]
  quotas      Json
  statut      JobStatut   @default(EN_COURS)
  lanceParId  String
  lancePar    Utilisateur @relation(fields: [lanceParId], references: [id])
  dateDebut   DateTime    @default(now())
  dateFin     DateTime?
  message     String?
}

// ---------- Paramètres globaux de l'application ----------

// Table à une seule ligne (id toujours "singleton") : évite d'inventer un
// magasin clé/valeur générique pour un unique réglage aujourd'hui, tout en
// restant facile à étendre avec d'autres colonnes plus tard.
model ParametresApplication {
  id                           String @id @default("singleton")
  // Nombre de jours après la khôlle avant d'envoyer un email de rappel au
  // kholleur s'il n'a pas encore saisi note/appréciation (0 = envoi
  // immédiat dès le lendemain de la khôlle). Voir src/lib/rappelsNotation.ts.
  delaiEnvoiMailsNotationJours Int    @default(0)
  // Corps de mail personnalisables par rôle destinataire (publipostage avec
  // #Nom / #Prénom, voir src/lib/modelesEmail.ts) ; null = texte par défaut.
  modeleEmailKholleur String?
  modeleEmailReferent String?
  modeleEmailEleve    String?
  // Case à cocher par rôle destinataire : permet de désactiver l'envoi sans
  // perdre le modèle personnalisé déjà saisi.
  envoiEmailKholleur Boolean @default(true)
  envoiEmailReferent Boolean @default(true)
  envoiEmailEleve    Boolean @default(true)
}

// Empêche de renvoyer plusieurs fois le même rappel à un kholleur pour une
// même session — une ligne est créée dès qu'un rappel est envoyé, jamais
// supprimée (même si le kholleur valide ensuite : inutile de la garder pour
// la logique d'envoi, mais elle ne gêne pas non plus).
model RappelNotationEnvoye {
  id              String   @id @default(cuid())
  sessionKholleId String
  kholleurId      String
  dateEnvoi       DateTime @default(now())

  @@unique([sessionKholleId, kholleurId])
}
