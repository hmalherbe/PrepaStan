# Reverse proxy de production : HTTPS automatique (Let's Encrypt), certificat
# obtenu et renouvelé tout seul dès que le nom de domaine pointe bien vers ce
# serveur (voir docker-compose.prod.yml).
#
# Remplacez "prepastan.fr" par votre vrai nom de domaine avant le premier
# déploiement.
prepastan.fr {
	reverse_proxy app:3000
}

# Environnement de démo/test séparé (voir docker-compose.demo.yml) : ce
# bloc suppose qu'un enregistrement DNS A pour demo.prepastan.fr pointe déjà
# vers ce serveur, sinon Caddy ne pourra pas obtenir de certificat pour ce
# sous-domaine (les logs du conteneur caddy le signaleront clairement).
demo.prepastan.fr {
	reverse_proxy app-demo:3000
}
