# Modèle pour la production (VPS + nom de domaine). Sur le serveur :
#   cp .env.production.example .env
# puis renseignez les vraies valeurs ci-dessous. Ce fichier .env sur le
# serveur n'est JAMAIS commité ni poussé sur GitHub (il est dans .gitignore),
# distinct de votre .env de développement local.

# Doit correspondre au mot de passe Postgres utilisé par le service "db"
# dans docker-compose.prod.yml (même valeur des deux côtés).
DB_PASSWORD="changez-moi-un-mot-de-passe-fort"
DATABASE_URL="postgresql://prepastan:changez-moi-un-mot-de-passe-fort@db:5432/prepastan?schema=public"

# Nom de domaine réel, en https.
NEXTAUTH_URL="https://prepastan.fr"
# Secret aléatoire et unique pour la prod — génèrez-en un avec :
#   openssl rand -base64 32
NEXTAUTH_SECRET="changez-moi"

# Adresse à laquelle le microservice solveur doit rappeler l'appli : le nom
# du service Docker ("app"), pas le nom de domaine public (voir le
# commentaire dans src/app/api/admin/planification/jobs/route.ts).
INTERNAL_APP_URL="http://app:3000"
PLANNING_SOLVER_URL="http://planning-solver:8001"
# Secret partagé entre l'appli et le solveur pour authentifier l'appel de
# callback — générez-en un aussi avec `openssl rand -base64 32`.
PLANNING_CALLBACK_SECRET="changez-moi"

# Pas de SEED_ADMIN_EMAIL/PASSWORD ni de RUN_SEED ici : ces variables ne
# servent qu'au script scripts/seed-on-deploy.mjs, lui-même appelé
# uniquement par le script npm "vercel-build" (déploiement Vercel) — pas par
# ce déploiement Docker, dont le seul point d'entrée est
# docker-entrypoint.sh (juste "prisma migrate deploy" + démarrage du
# serveur). Les définir ici n'aurait donc aucun effet.
#
# Pour créer le compte admin sur ce déploiement, une fois les conteneurs
# lancés :
#   docker compose -f docker-compose.prod.yml exec app node -e "
#     const { PrismaClient } = require('@prisma/client');
#     const bcrypt = require('bcryptjs');
#     const prisma = new PrismaClient();
#     (async () => {
#       const hash = await bcrypt.hash('VOTRE_VRAI_MOT_DE_PASSE', 12);
#       await prisma.utilisateur.upsert({
#         where: { email: 'admin@prepastan.fr' },
#         update: {},
#         create: { email: 'admin@prepastan.fr', password: hash, nom: 'Admin', prenom: 'PrepaStan', roles: ['ADMIN'] },
#       });
#       console.log('Compte admin créé.');
#       await prisma.\$disconnect();
#     })();
#   "

# Optionnel : notifications email aux khôlleurs (voir src/lib/email.ts).
# Laissez vide/absent pour désactiver proprement les envois.
# RESEND_API_KEY="re_..."
# RESEND_FROM_EMAIL="PrepaStan <notifications@prepastan.fr>"
