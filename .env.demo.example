# Modèle pour l'environnement de démo/test (base + appli séparées de la
# production, normalement sur le sous-domaine demo.prepastan.fr — ou en
# repli temporaire par IP:port, voir NEXTAUTH_URL plus bas). Sur le
# serveur :
#   cp .env.demo.example .env.demo
# puis renseignez les vraies valeurs ci-dessous. Ce fichier n'est JAMAIS
# commité ni poussé sur GitHub (il est dans .gitignore), distinct du .env de
# production et de celui de développement local.

# Lu directement par le conteneur "db-demo" (image postgres officielle) :
# choisissez un mot de passe DIFFÉRENT de celui de la production, et
# reportez la même valeur dans DATABASE_URL juste en dessous (les deux
# doivent correspondre).
POSTGRES_USER="prepastan"
POSTGRES_PASSWORD="changez-moi-un-mot-de-passe-fort-different-de-la-prod"
POSTGRES_DB="prepastan"
DATABASE_URL="postgresql://prepastan:changez-moi-un-mot-de-passe-fort-different-de-la-prod@db-demo:5432/prepastan?schema=public"

# Sous-domaine de démo, en https — l'enregistrement DNS A doit déjà exister
# et pointer vers ce serveur avant le premier démarrage (voir Caddyfile).
#
# Repli temporaire tant que demo.prepastan.fr ne résout pas (souci DNS côté
# registrar) : accès direct par IP:port (voir le "ports" publié dans
# docker-compose.demo.yml). NextAuth adapte automatiquement ses cookies au
# HTTP dès lors que cette URL commence par "http://" (pas de code à changer,
# voir next-auth/core/init.js, useSecureCookies dérivé de cette URL) — mais
# repassez impérativement à la ligne https ci-dessus dès que le DNS est bon,
# pour ne plus faire transiter les mots de passe en clair sur le réseau.
NEXTAUTH_URL="http://163.172.9.248:8080"
# NEXTAUTH_URL="https://demo.prepastan.fr"
# Secret DIFFÉRENT de celui de la production — générez-en un avec :
#   openssl rand -base64 32
NEXTAUTH_SECRET="changez-moi"

# Adresse à laquelle le microservice solveur (partagé avec la prod, voir
# docker-compose.demo.yml) doit rappeler CETTE appli-ci : le nom du service
# Docker "app-demo", jamais le nom de domaine public.
INTERNAL_APP_URL="http://app-demo:3000"
PLANNING_SOLVER_URL="http://planning-solver:8001"
# Secret DIFFÉRENT de celui de la production — générez-en un aussi avec
# `openssl rand -base64 32`. Comme ce secret ne fait que transiter dans la
# requête envoyée au solveur (voir jobs/route.ts), le partager avec un autre
# environnement n'aurait de toute façon aucun sens : chaque environnement
# doit avoir le sien.
PLANNING_CALLBACK_SECRET="changez-moi"

# IMPORTANT : si vous renseignez RESEND_API_KEY ici (même clé et même
# expéditeur que la prod, aucun souci à les partager), activez TOUJOURS le
# mode test dans Paramètres (démo) en même temps, avec une adresse de
# destination valide — et laissez-le coché en permanence. Sans ça, toute
# publication de planning sur démo tenterait de vraiment envoyer aux
# adresses synthétiques des comptes copiés par le script de copie du roster
# (prenom.nom@demo.prepastan.local, jamais les vraies adresses — voir ce
# script) : ça échouerait en bounce chez Resend plutôt que d'atteindre qui
# que ce soit, mais ça consommerait inutilement le quota d'envoi et
# polluerait le tableau de bord Resend. Tant que RESEND_API_KEY reste
# commentée (valeur par défaut), les emails échouent silencieusement (voir
# src/lib/email.ts, qui ne lève jamais d'exception) : rien ne part jamais
# depuis la démo, pas même en mode test.
# RESEND_API_KEY="re_..."
# RESEND_FROM_EMAIL="PrepaStan <notifications@prepastan.fr>"
