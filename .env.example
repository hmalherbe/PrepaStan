# PostgreSQL
DATABASE_URL="postgresql://prepastan:prepastan@localhost:5432/prepastan?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="changeme"

# Microservice de planification (OR-Tools)
PLANNING_SOLVER_URL="http://localhost:8001"
PLANNING_CALLBACK_SECRET="changeme"

# Email (Brevo) — notifie les kholleurs à la publication d'un planning.
# Sans BREVO_API_KEY, l'envoi est simplement ignoré (logué en console).
# Compte gratuit sur https://www.brevo.com, clé API dans SMTP & API > API Keys.
BREVO_API_KEY=""
# L'adresse doit appartenir à un domaine vérifié dans Brevo (Senders,
# Domains & Dedicated IPs > Domains > Add a domain, vérification par DNS,
# pas besoin que la boîte existe réellement une fois le domaine vérifié).
BREVO_FROM_EMAIL="PrepaStan <contact@prepastan.fr>"
# Optionnel : adresse où atterrissent les réponses des destinataires (simple
# en-tête email, aucune configuration Brevo requise). Laissez absent pour ne
# poser aucun Reply-To.
# EMAIL_REPLY_TO="contact@prepastan.fr"
