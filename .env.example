# PostgreSQL
DATABASE_URL="postgresql://prepastan:prepastan@localhost:5432/prepastan?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="changeme"

# Microservice de planification (OR-Tools)
PLANNING_SOLVER_URL="http://localhost:8001"
PLANNING_CALLBACK_SECRET="changeme"

# Email (Resend) — notifie les kholleurs à la publication d'un planning.
# Sans RESEND_API_KEY, l'envoi est simplement ignoré (logué en console).
# Clé à récupérer sur https://resend.com/api-keys (compte gratuit).
RESEND_API_KEY=""
# Tant que votre domaine n'est pas vérifié sur Resend, laissez la valeur par
# défaut ("PrepaStan <onboarding@resend.dev>") : les emails ne partiront
# alors que vers l'adresse de votre propre compte Resend, pratique pour
# tester avant de configurer un vrai domaine d'envoi.
RESEND_FROM_EMAIL="PrepaStan <onboarding@resend.dev>"
